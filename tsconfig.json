{
  "compilerOptions": {
    "target": "ES2015", // Обновите до ES2015 или выше
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "downlevelIteration": true // Включите этот флаг
  },
  "include": ["src", "src/hooks/useLogin.ts"],
  "exclude": ["node_modules", "src/server/index.js", "build"]
}
